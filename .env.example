APP_NAME=SOUL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SOUL_TERMS_VERSION=1.0
SOUL_PRIVACY_VERSION=1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SOUL_PRIVATE_EXPORT_DISK=local
SOUL_FAILED_WEBHOOK_RETENTION_DAYS=30
SOUL_DELIVERED_NOTIFICATION_RETENTION_DAYS=90
SOUL_FAILED_NOTIFICATION_RETENTION_DAYS=180
SOUL_QUEUE_WARNING_COUNT=1000
SOUL_QUEUE_WAIT_WARNING_SECONDS=900
SOUL_FAILED_JOBS_WARNING_COUNT=0
SOUL_STALE_EXPORT_WARNING_COUNT=0
SOUL_STALE_NOTIFICATION_WARNING_COUNT=0
SOUL_STALE_WEBHOOK_WARNING_COUNT=0
SOUL_STORE_WEBHOOK_BACKLOG_WARNING_COUNT=500
SOUL_NOTIFICATION_PROVIDER_FAILURE_WARNING_COUNT=25
SOUL_STORE_PROVIDER_FAILURE_WARNING_COUNT=10
SOUL_CRITICAL_INCIDENT_ACK_SLA_MINUTES=15
SOUL_INCIDENT_HISTORY_RETENTION_DAYS=365
SOUL_OPERATIONS_ALERT_CHANNEL=
SOUL_OPERATIONS_ALERT_OWNER=
SOUL_OPERATIONS_RUNBOOK_URL=
SOUL_STORE_WEBHOOK_BACKLOG_LIMIT=10000
SOUL_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
SOUL_PROVIDER_CIRCUIT_FAILURE_WINDOW_SECONDS=60
SOUL_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
SOUL_PROVIDER_CIRCUIT_PROBE_LEASE_SECONDS=15
SOUL_SLOW_QUERY_WARNING_MS=500
SOUL_DATABASE_CONNECTION_WARNING_PERCENT=80
SOUL_BACKUP_MAXIMUM_AGE_HOURS=24
SOUL_SYNTHETIC_MAX_USERS=50000
SOUL_SYNTHETIC_MAX_MATCHES=50000
SOUL_SYNTHETIC_MAX_MESSAGES_PER_MATCH=100
SOUL_MAXIMUM_ACTIVE_SESSIONS=20
SOUL_MAXIMUM_JSON_REQUEST_KILOBYTES=256
SOUL_MAXIMUM_MULTIPART_REQUEST_KILOBYTES=6144
SOUL_TRUSTED_PROXIES=
SOUL_CORS_ALLOWED_ORIGINS=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEOLOCATION_DRIVER=none
CLOUDFLARE_LOCATION_HEADERS_ENABLED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_SESSION_TTL_MINUTES=10
CLOUDINARY_WEBHOOK_TOLERANCE_SECONDS=7200
CLOUDINARY_RESPONSE_SIGNATURE_ALGORITHM=sha256

# Comma-separated Google OAuth client IDs accepted by the backend.
# Add Android, iOS and Web client IDs when they are available.
GOOGLE_CLIENT_IDS=
# Comma-separated Apple App bundle IDs or Services IDs accepted as audiences.
APPLE_CLIENT_IDS=

# Store verification credentials (keep private keys in the deployment secret manager).
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Mobile delivery credentials.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
